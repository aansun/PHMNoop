    "Recovery out of date, last synced %@. Open PHMN on iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladung veraltet, zuletzt synchronisiert %@. Öffne PHMN auf dem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery out of date, last synced %@. Open PHMN on iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga desatualizada, última sincronização %@. Abra o PHMN no iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд устарел, последняя синхронизация %@. Откройте PHMN на iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga fuera de la fecha, última sincronizada %1$@. Abrir PHMN en iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery hors date, dernière synchronisation %1$@. Ouvrez PHMN sur iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energia nieaktualny, ostatnia synchronizacja %@. Otwórz PHMN na iPhonie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能量数据已过期，上次同步 %@。请在 iPhone 上打开 PHMN。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能量資料已過期，上次同步 %@。請在 iPhone 上開啟 PHMN。"
          }
        }
      }
    },
