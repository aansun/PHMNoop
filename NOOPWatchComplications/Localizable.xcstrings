    "PHMN. No data yet, open PHMN on your iPhone to sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. Noch keine Daten, öffne PHMN auf deinem iPhone zum Synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. No data yet, open PHMN on your iPhone to sync."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Ainda não há dados, abra o PHMN no teu iPhone para tincronizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. Данных пока нет, откройте PHMN на iPhone для синхронизации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. Aún no hay datos, abra PHMN en su iPhone para sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Pas encore de données, ouvrez PHMN sur votre iPhone pour synchroniser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. Nie ma jeszcze danych. Otwórz PHMN na swoim iPhonie, aby przeprowadzić synchronizację."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN。暂无数据，请在 iPhone 上打开 PHMN 进行同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN。暫無資料，請在 iPhone 上開啟 PHMN 進行同步。"
          }
        }
      }
    },
    "PHMN. Scores out of date, last synced %@. Open PHMN on iPhone to refresh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. Werte veraltet, zuletzt synchronisiert %@. Öffne PHMN auf dem iPhone zum Aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. Scores out of date, last synced %@. Open PHMN on iPhone to refresh."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Pontuações desatualizadas, última sincronização %@. Abra o PHMN no iPhone para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. Показатели устарели, последняя синхронизация %@. Откройте PHMN на iPhone, чтобы обновить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. Resultados fuera de la fecha, último sincronizado %1$@. Abra PHMN en iPhone para refrescarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Les scores sont dépassés, le dernier %1$@ synchronisé. Ouvrez PHMN sur iPhone pour vous rafraîchir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN. Wyniki nieaktualne, ostatnia synchronizacja %@. Otwórz PHMN na iPhonie, aby odświeżyć."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN。评分已过期，上次同步 %@。请在 iPhone 上打开 PHMN 以刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PHMN。評分已過期，上次同步 %@。請在 iPhone 上開啟 PHMN 以重新整理。"
          }
        }
      }
    },
